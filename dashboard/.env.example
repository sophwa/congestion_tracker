# dashboard/.env.example
# Copy this file to dashboard/.env and fill in your values.

# URL of the running FastAPI service (local dev or deployed)
API_BASE_URL=http://localhost:8000

# Ollama Cloud base URL (e.g. https://your-ollama-cloud-host)
# For local Ollama, use http://localhost:11434
OLLAMA_BASE_URL=https://ollama.com

# Model name as deployed on Ollama Cloud (e.g. llama3.2, mistral)
OLLAMA_MODEL=gpt-oss:20b-cloud

# API key for Ollama Cloud authentication
OLLAMA_API_KEY=your-ollama-cloud-api-key
